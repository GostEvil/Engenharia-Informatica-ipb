			ORG 100
Loop,		Load X
			Subt Ten
        	Skipcond 000
        	Jump EndLoop
        	Load X
            Add One
            Store X
            Jump Loop
            
EndLoop,	Halt
X,			DEC 1
One,		DEC 1
Ten,		DEC 10